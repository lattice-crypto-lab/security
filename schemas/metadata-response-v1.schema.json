{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadata",
  "type": "object",
  "properties": {
    "adapter_schema_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "adapter_version": {
      "type": "string"
    },
    "adaptive_attacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attack"
      }
    },
    "approximation": {
      "$ref": "#/$defs/ApproximationMetadata",
      "default": {
        "attacks": [],
        "available": false,
        "group_count": 0
      }
    },
    "dependency_graph": true,
    "dependency_graph_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "estimator_commit": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "sage_version": {
      "type": "string"
    },
    "support_matrix": true,
    "worker_image": {
      "type": "string"
    }
  },
  "required": [
    "adapter_schema_version",
    "dependency_graph_version",
    "estimator_commit",
    "sage_version",
    "adapter_version",
    "worker_image",
    "platform",
    "support_matrix",
    "dependency_graph",
    "adaptive_attacks"
  ],
  "$defs": {
    "ApproximationMetadata": {
      "type": "object",
      "properties": {
        "attacks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Attack"
          }
        },
        "available": {
          "type": "boolean"
        },
        "dataset_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "model_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "available",
        "group_count"
      ]
    },
    "Attack": {
      "type": "string",
      "enum": [
        "arora_gb",
        "bkw",
        "usvp",
        "bdd",
        "bdd_hybrid",
        "bdd_mitm_hybrid",
        "dual",
        "dual_hybrid",
        "dsd",
        "lattice"
      ]
    }
  }
}
