{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatchSnapshot",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "job_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "poll_after_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/SecurityReportFile"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "state",
    "revision",
    "created_at",
    "updated_at",
    "poll_after_seconds",
    "job_ids"
  ],
  "$defs": {
    "AnalysisModel": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct_lwe"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct_ntru"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct_sis"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "derived_lwe": {
              "$ref": "#/$defs/LweProblem"
            },
            "kind": {
              "type": "string",
              "const": "coefficient_embedding_v1"
            },
            "scalar_samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "source_ring_samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "version",
            "source_ring_samples",
            "scalar_samples",
            "derived_lwe",
            "warnings"
          ]
        }
      ]
    },
    "AnalysisSettings": {
      "type": "object",
      "properties": {
        "cost_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionCostModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "reduction_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_model": {
          "$ref": "#/$defs/SecurityModel"
        },
        "shape_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionShapeModel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "security_model"
      ]
    },
    "ApproximationProvenance": {
      "type": "object",
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "dataset_hash": {
          "type": "string"
        },
        "estimator_commit": {
          "type": "string"
        },
        "feature_schema": {
          "type": "string"
        },
        "holdout_max_overestimate_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "holdout_mean_absolute_error_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "holdout_p95_absolute_error_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "holdout_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "model_hash": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "platform": {
          "type": "string"
        },
        "safety_margin_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "sage_version": {
          "type": "string"
        },
        "training_points": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "worker_image": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_version",
        "model_hash",
        "dataset_hash",
        "feature_schema",
        "estimator_commit",
        "sage_version",
        "adapter_version",
        "worker_image",
        "platform",
        "training_points",
        "holdout_samples",
        "holdout_mean_absolute_error_bits",
        "holdout_p95_absolute_error_bits",
        "holdout_max_overestimate_bits",
        "safety_margin_bits"
      ]
    },
    "Attack": {
      "type": "string",
      "enum": [
        "arora_gb",
        "bkw",
        "usvp",
        "bdd",
        "bdd_hybrid",
        "bdd_mitm_hybrid",
        "dual",
        "dual_hybrid",
        "dsd",
        "lattice"
      ]
    },
    "AttackOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "computed"
            },
            "metrics": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/NormalizedMetric"
              },
              "default": {}
            },
            "security_bits": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "security_bits",
            "duration_ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "approximate"
            },
            "provenance": {
              "$ref": "#/$defs/ApproximationProvenance"
            },
            "security_bits": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "security_bits",
            "provenance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "no_finite_estimate"
            },
            "raw_result": true,
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeout"
            },
            "timeout_seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "timeout_seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "unsupported"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "message",
            "retryable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "applicability_rule_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "policy_skipped"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "reason",
            "applicability_rule_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skipped"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ]
        }
      ]
    },
    "AttackResult": {
      "type": "object",
      "properties": {
        "attack": {
          "$ref": "#/$defs/Attack"
        },
        "cached": {
          "type": "boolean",
          "default": false
        },
        "outcome": {
          "$ref": "#/$defs/AttackOutcome"
        }
      },
      "additionalProperties": false,
      "required": [
        "attack",
        "outcome"
      ]
    },
    "ErrorDistribution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete_gaussian"
            },
            "standard_deviation": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "standard_deviation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "eta": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "centered_binomial"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "eta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_integer"
            },
            "lower": {
              "$ref": "#/$defs/SignedInteger"
            },
            "upper": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper"
          ]
        }
      ]
    },
    "ExactDecimal": {
      "description": "A canonical, finite base-10 decimal serialized as a JSON string.",
      "type": "string",
      "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$"
    },
    "LweProblem": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "error": {
          "$ref": "#/$defs/ErrorDistribution"
        },
        "modulus": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "samples": {
          "$ref": "#/$defs/SampleCount"
        },
        "secret": {
          "$ref": "#/$defs/SecretDistribution"
        }
      },
      "additionalProperties": false,
      "required": [
        "dimension",
        "modulus",
        "samples",
        "secret",
        "error"
      ]
    },
    "NegacyclicRing": {
      "type": "object",
      "properties": {
        "ciphertext_modulus": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "polynomial_degree": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "polynomial_degree",
        "ciphertext_modulus"
      ]
    },
    "NormalizedMetric": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "decimal"
            },
            "value": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "NtruStructure": {
      "type": "string",
      "enum": [
        "matrix",
        "circulant"
      ]
    },
    "ParameterCase": {
      "type": "object",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisSettings",
          "default": {
            "security_model": "classical"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "$ref": "#/$defs/Problem"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "problem"
      ]
    },
    "PositiveInteger": {
      "description": "A canonical unsigned decimal integer serialized as a JSON string.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Problem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "lwe"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "rlwe"
            },
            "negacyclic_ring": {
              "$ref": "#/$defs/NegacyclicRing"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "negacyclic_ring",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "glwe"
            },
            "negacyclic_ring": {
              "$ref": "#/$defs/NegacyclicRing"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "negacyclic_ring",
            "dimension",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "ntru"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            },
            "structure": {
              "$ref": "#/$defs/NtruStructure"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "secret",
            "error",
            "structure"
          ]
        },
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "sis"
            },
            "length_bound": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "norm": {
              "$ref": "#/$defs/SisNorm"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "columns",
            "length_bound",
            "norm"
          ]
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "analysis_model": {
          "$ref": "#/$defs/AnalysisModel"
        },
        "created_at": {
          "type": "string"
        },
        "estimator_commit": {
          "type": "string"
        },
        "resolved_analysis": {
          "$ref": "#/$defs/ResolvedAnalysisSettings"
        },
        "sage_version": {
          "type": "string"
        },
        "worker_image": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "estimator_commit",
        "sage_version",
        "adapter_version",
        "worker_image",
        "analysis_model",
        "resolved_analysis",
        "created_at"
      ]
    },
    "ReductionCostModel": {
      "type": "string",
      "enum": [
        "BDGL16",
        "LaaMosPol14"
      ]
    },
    "ReductionModel": {
      "type": "string",
      "enum": [
        "coefficient_embedding_v1"
      ]
    },
    "ReductionShapeModel": {
      "type": "string",
      "enum": [
        "GSA"
      ]
    },
    "ResolvedAnalysisSettings": {
      "type": "object",
      "properties": {
        "cost_model": {
          "$ref": "#/$defs/ReductionCostModel"
        },
        "reduction_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_model": {
          "$ref": "#/$defs/SecurityModel"
        },
        "shape_model": {
          "$ref": "#/$defs/ReductionShapeModel"
        }
      },
      "additionalProperties": false,
      "required": [
        "security_model",
        "cost_model",
        "shape_model"
      ]
    },
    "RunState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending"
            },
            "staged_at": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "staged_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "queued"
            },
            "queued_at": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "queued_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "heartbeat_at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "running"
            },
            "started_at": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "started_at",
            "heartbeat_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cancel_requested"
            },
            "requested_at": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "requested_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "finished_at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "finished_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "finished_at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "finished_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "finished_at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "partial"
            }
          },
          "additionalProperties": false,
