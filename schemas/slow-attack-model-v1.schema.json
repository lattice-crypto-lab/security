{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApproximationModelFile",
  "type": "object",
  "properties": {
    "feature_schema": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ApproximationGroup"
      }
    },
    "model_id": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/CalibrationProvenance"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "model_id",
    "generated_at",
    "feature_schema",
    "provenance",
    "groups"
  ],
  "$defs": {
    "ApproximationDomain": {
      "type": "object",
      "properties": {
        "log2_dimension": {
          "$ref": "#/$defs/FeatureRange"
        },
        "log2_error_standard_deviation": {
          "$ref": "#/$defs/FeatureRange"
        },
        "log2_modulus": {
          "$ref": "#/$defs/FeatureRange"
        },
        "log2_samples": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "log2_dimension",
        "log2_modulus",
        "log2_error_standard_deviation"
      ]
    },
    "ApproximationGroup": {
      "type": "object",
      "properties": {
        "attack": {
          "$ref": "#/$defs/Attack"
        },
        "cost_model": {
          "$ref": "#/$defs/ReductionCostModel"
        },
        "domain": {
          "$ref": "#/$defs/ApproximationDomain"
        },
        "holdout": {
          "$ref": "#/$defs/HoldoutMetrics"
        },
        "id": {
          "type": "string"
        },
        "max_normalized_distance": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "neighbor_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CalibrationPoint"
          }
        },
        "safety_margin_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "sample_mode": {
          "$ref": "#/$defs/CalibrationSampleMode"
        },
        "secret": {
          "$ref": "#/$defs/SecretDistribution"
        },
        "security_model": {
          "$ref": "#/$defs/SecurityModel"
        },
        "shape_model": {
          "$ref": "#/$defs/ReductionShapeModel"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "attack",
        "security_model",
        "cost_model",
        "shape_model",
        "secret",
        "sample_mode",
        "domain",
        "neighbor_count",
        "max_normalized_distance",
        "safety_margin_bits",
        "holdout",
        "points"
      ]
    },
    "Attack": {
      "type": "string",
      "enum": [
        "arora_gb",
        "bkw",
        "usvp",
        "bdd",
        "bdd_hybrid",
        "bdd_mitm_hybrid",
        "dual",
        "dual_hybrid",
        "dsd",
        "lattice"
      ]
    },
    "CalibrationPoint": {
      "type": "object",
      "properties": {
        "log2_dimension": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "log2_error_standard_deviation": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "log2_modulus": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "log2_samples": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_bits": {
          "$ref": "#/$defs/ExactDecimal"
        }
      },
      "additionalProperties": false,
      "required": [
        "log2_dimension",
        "log2_modulus",
        "log2_error_standard_deviation",
        "security_bits"
      ]
    },
    "CalibrationProvenance": {
      "type": "object",
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "dataset_hash": {
          "type": "string"
        },
        "estimator_commit": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "sage_version": {
          "type": "string"
        },
        "worker_image": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "estimator_commit",
        "sage_version",
        "adapter_version",
        "worker_image",
        "platform",
        "dataset_hash"
      ]
    },
    "CalibrationSampleMode": {
      "type": "string",
      "enum": [
        "unlimited",
        "finite"
      ]
    },
    "ExactDecimal": {
      "description": "A canonical, finite base-10 decimal serialized as a JSON string.",
      "type": "string",
      "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$"
    },
    "FeatureRange": {
      "type": "object",
      "properties": {
        "max": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "min": {
          "$ref": "#/$defs/ExactDecimal"
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "HoldoutMetrics": {
      "type": "object",
      "properties": {
        "max_overestimate_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "mean_absolute_error_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "p95_absolute_error_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "samples",
        "mean_absolute_error_bits",
        "p95_absolute_error_bits",
        "max_overestimate_bits"
      ]
    },
    "ReductionCostModel": {
      "type": "string",
      "enum": [
        "BDGL16",
        "LaaMosPol14"
      ]
    },
    "ReductionShapeModel": {
      "type": "string",
      "enum": [
        "GSA"
      ]
    },
    "SecretDistribution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_ternary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sparse_ternary"
            },
            "negative_count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "positive_count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "positive_count",
            "negative_count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hamming_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "fixed_weight_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "hamming_weight"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed_weight_ternary"
            },
            "negative_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "positive_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "positive_weight",
            "negative_weight"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete_gaussian"
            },
            "standard_deviation": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "standard_deviation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "eta": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "centered_binomial"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "eta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_integer"
            },
            "lower": {
              "$ref": "#/$defs/SignedInteger"
            },
            "upper": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper"
          ]
        }
      ]
    },
    "SecurityModel": {
      "type": "string",
      "enum": [
        "classical",
        "quantum"
      ]
    },
    "SignedInteger": {
      "description": "A canonical signed decimal integer serialized as a JSON string.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    }
  }
}
