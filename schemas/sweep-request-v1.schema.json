{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SweepRequest",
  "type": "object",
  "properties": {
    "axes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SweepAxis"
      },
      "maxItems": 4,
      "minItems": 1
    },
    "base_case": {
      "$ref": "#/$defs/ParameterCase"
    },
    "slow_attack_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/SlowAttackPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "format": "uint64",
      "default": 3600,
      "maximum": 7200,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "base_case",
    "axes"
  ],
  "$defs": {
    "AnalysisSettings": {
      "type": "object",
      "properties": {
        "cost_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionCostModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "reduction_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_model": {
          "$ref": "#/$defs/SecurityModel"
        },
        "shape_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionShapeModel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "security_model"
      ]
    },
    "ErrorDistribution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete_gaussian"
            },
            "standard_deviation": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "standard_deviation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "eta": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "centered_binomial"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "eta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_integer"
            },
            "lower": {
              "$ref": "#/$defs/SignedInteger"
            },
            "upper": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper"
          ]
        }
      ]
    },
    "ExactDecimal": {
      "description": "A canonical, finite base-10 decimal serialized as a JSON string.",
      "type": "string",
      "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$"
    },
    "NegacyclicRing": {
      "type": "object",
      "properties": {
        "ciphertext_modulus": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "polynomial_degree": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "polynomial_degree",
        "ciphertext_modulus"
      ]
    },
    "NtruStructure": {
      "type": "string",
      "enum": [
        "matrix",
        "circulant"
      ]
    },
    "ParameterCase": {
      "type": "object",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisSettings",
          "default": {
            "security_model": "classical"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "$ref": "#/$defs/Problem"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "problem"
      ]
    },
    "PositiveInteger": {
      "description": "A canonical unsigned decimal integer serialized as a JSON string.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Problem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "lwe"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "rlwe"
            },
            "negacyclic_ring": {
              "$ref": "#/$defs/NegacyclicRing"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "negacyclic_ring",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "glwe"
            },
            "negacyclic_ring": {
              "$ref": "#/$defs/NegacyclicRing"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "negacyclic_ring",
            "dimension",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "ntru"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            },
            "structure": {
              "$ref": "#/$defs/NtruStructure"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "secret",
            "error",
            "structure"
          ]
        },
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "sis"
            },
            "length_bound": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "norm": {
              "$ref": "#/$defs/SisNorm"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "columns",
            "length_bound",
            "norm"
          ]
        }
      ]
    },
    "ReductionCostModel": {
      "type": "string",
      "enum": [
        "BDGL16",
        "LaaMosPol14"
      ]
    },
    "ReductionModel": {
      "type": "string",
      "enum": [
        "coefficient_embedding_v1"
      ]
    },
    "ReductionShapeModel": {
      "type": "string",
      "enum": [
        "GSA"
      ]
    },
    "SampleCount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "finite"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unlimited"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SecretDistribution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_ternary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Independent coefficients with P(-1)=1/4, P(0)=1/2, and P(1)=1/4.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sparse_ternary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hamming_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "fixed_weight_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "hamming_weight"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed_weight_ternary"
            },
            "negative_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "positive_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "positive_weight",
            "negative_weight"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete_gaussian"
            },
            "standard_deviation": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "standard_deviation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "eta": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "centered_binomial"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "eta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_integer"
            },
            "lower": {
              "$ref": "#/$defs/SignedInteger"
            },
            "upper": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper"
          ]
        }
      ]
    },
    "SecurityModel": {
      "type": "string",
      "enum": [
        "classical",
        "quantum"
      ]
    },
    "SignedInteger": {
      "description": "A canonical signed decimal integer serialized as a JSON string.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "SisNorm": {
      "type": "string",
      "enum": [
        "l2",
        "l_infinity"
      ]
    },
    "SlowAttackPolicy": {
      "type": "object",
      "properties": {
        "required_security_bits": {
          "$ref": "#/$defs/ExactDecimal"
        },
        "stop_margin_bits": {
          "$ref": "#/$defs/ExactDecimal"
        }
      },
      "additionalProperties": false,
      "required": [
        "required_security_bits",
        "stop_margin_bits"
      ]
    },
    "SweepAxis": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dimension"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "maxItems": 10000,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "modulus"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PositiveInteger"
              },
              "maxItems": 10000,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "error_standard_deviation"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ExactDecimal"
              },
              "maxItems": 10000,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sample_count"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "maxItems": 10000,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ]
        }
      ]
    }
  }
}
